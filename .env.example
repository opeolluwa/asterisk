ACCESS_TOKEN_TTL_IN_MINUTES=120

ALLOWED_ORIGINS=http://localhost:8000,http://localhost:5600,http://0.0.0.0:8000

BODY_LIMIT_MB=25
BODY_LIMIT_MEGA_BYTES=25

CACHE_TTL_IN_SECONDS=600

CONSOLE_URL=http://localhost:5600
CONSOLE_URL=https://example.com/

DATABASE_HOST=postgres
DATABASE_NAME=asterisk
DATABASE_PASSWORD=asterisk
DATABASE_PORT=5432
DATABASE_URL=postgres://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}
DATABASE_USER=asterisk

# The From identity stamped on outgoing mail. The API provider rejects any
# domain the account has not verified, so set this to a domain your Mailtrap
# account owns when EMAIL_PROVIDER=mailtrap.
EMAIL_FROM_ADDRESS=accounts@asterisk.app
EMAIL_FROM_NAME="asterisk Accounts"
# Which transport delivers mail. Either smtp or mailtrap; only the selected
# provider's credentials below are required, so you can leave the other set
# empty. Both go through the same `emails` queue, so switching needs no redeploy
# of the worker logic.
EMAIL_PROVIDER=smtp

ENVIRONMENT=dev

EXPORT_PATH=tmp

FRONTEND_URL=http://localhost:7008

IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_UPLOAD_URL=http://mmock:8083/api/v1/files/upload

# 32+ random characters. The server refuses to start without one: an empty key
# would let anyone mint tokens.
JWT_SIGNING_KEY=dev-only-placeholder-key-32chars-min-0123456789abcdef

LOG_LEVEL=info

# Required when EMAIL_PROVIDER=mailtrap. The token is the sending API token,
# not the SMTP credentials above.
MAILTRAP_API_TOKEN=
MAILTRAP_BASE_URL=https://send.api.mailtrap.io/api/send

MAX_DB_CONNECTIONS=10

PAYSTACK_API_KEY=
PAYSTACK_API_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co/transaction/initialize
PAYSTACK_VERIFY_BASE_URL=https://api.paystack.co/transaction/verify

PORT=5006

RATE_LIMIT_AUTH_PER_HOUR=30
RATE_LIMIT_AUTH_PER_MINUTE=5
RATE_LIMIT_BURST=10
RATE_LIMIT_MAX_KEYS=100000
RATE_LIMIT_OTP_PER_HOUR=10
RATE_LIMIT_OTP_PER_MINUTE=2
RATE_LIMIT_PER_MINUTE=50
RATE_LIMIT_RPS=5

REDIS_CONNECTION_URL=redis://redis:6379

REFRESH_TOKEN_TTL_IN_MINUTES=420

REQUESTS_TIME_OUT_SECS=12

SMTP_AUTH_PASSWORD=
SMTP_AUTH_USERNAME=
# Required when EMAIL_PROVIDER=smtp. Leave the credentials empty for a local
# sink such as maildev, which has no authentication.
SMTP_HOST=maildev
SMTP_PORT=1025
SMTP_TLS_MODE=none

UPLOAD_PATH=tmp
